# development | testing | production. Anything else is rejected; unset means production.
APP_ENV=development

# REQUIRED. No default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required in production. Use a dedicated database user with a strong password.
DATABASE_URL=postgresql+psycopg://transit_app:CHANGE_ME@localhost:5432/transit_ops
# Optional read replica. Falls back to DATABASE_URL.
READ_REPLICA_URL=

# Set to 1 only for local development (the debugger allows remote code execution).
FLASK_DEBUG=0

# Cookies are Secure by default in production; leave unset there.
# SESSION_COOKIE_SECURE=1
# SESSION_HOURS=8
# Number of reverse proxies in front of the app (so client IPs and https are read correctly).
# TRUSTED_PROXY_COUNT=1

# Local convenience only: create tables from the models instead of running Alembic.
# AUTO_CREATE_SCHEMA=0

LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=15
